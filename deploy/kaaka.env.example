# Kaaka server settings. Copy to /etc/kaaka/kaaka.env (systemd, chmod 600) or export before running
# server/server.py. Unset optional settings disable that feature.

# Required when the server is reachable from the internet: the dashboard (/admin), the API and the
# WebSocket need this token (same value in the Kaaka Call gateway app). Location links stay public.
# Optional public demo PIN shown on the landing and login pages; anyone can open the control room with it.
# Use only for demos (it exposes every incident) and remove it afterwards.
#KAAKA_DEMO_PIN=1234

KAAKA_ADMIN_TOKEN=change-me-to-a-long-random-string

# Public https URL of this server (shown on the dashboard; the gateway app builds location links).
# Setting it without KAAKA_ADMIN_TOKEN refuses to start.
KAAKA_PUBLIC_URL=https://kaaka.example.org

# Runtime data: events.jsonl, responders.json, last_call.json, latest_telemetry.json.
# Default: the server/ directory. The systemd unit sets /var/lib/kaaka.
#KAAKA_DATA_DIR=/var/lib/kaaka

# Interactive console (Enter = test call). Off automatically when stdin is not a terminal; 0 forces it off.
#KAAKA_CONSOLE=0

# macOS notifications for new incidents (1/0). Linux ignores it.
#KAAKA_NOTIFY=0

# Seconds without a gateway heartbeat before the phone counts as silent (default 1200).
#KAAKA_STALE_SECONDS=1200

# Bluetooth hands-free mode (Linux with BlueZ/PipeWire, or macOS with mac/hfp-bridge) instead of the gateway app.
#KAAKA_BT_MAC=AA:BB:CC:DD:EE:FF
#KAAKA_CLIENT_NUMBER=+919800000000
#KAAKA_ADB_SERIAL=

# Linux voice-AI audio bridge (needs the `requests` package and ffmpeg).
#KAAKA_WEBHOOK_URL=
#KAAKA_WEBHOOK_FALLBACK_URL=
#KAAKA_SPEAKER_SINK=
#KAAKA_MIC_SOURCE=
