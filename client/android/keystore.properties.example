# Release signing for the Android app. Copy to keystore.properties (gitignored) and fill in.
# storeFile may be absolute or relative to this android/ directory.
# Generate a keystore with:
#   keytool -genkeypair -v -keystore kaaka-release.jks -alias kaaka -keyalg RSA -keysize 4096 -validity 10000
storeFile=/absolute/path/to/kaaka-release.jks
storePassword=CHANGE_ME
keyAlias=kaaka
keyPassword=CHANGE_ME
